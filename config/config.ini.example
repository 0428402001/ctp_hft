; ============================================================================
;  ctp_hft - offline simulation config (mode = sim, no broker, no network)
;  This is the ONLY self-test config: verify_sim.bat uses it to prove
;  signal -> order -> fill -> bracket exit -> round trip in a few seconds.
;  Production/live testing uses config_simnow.ini or config_simnow724.ini.
;  Lines starting with ';' or '#' are comments.
; ============================================================================

[account]
; --- login information -------------------------------------------------------
broker_id  = 9999
user_id    = YOUR_USER_ID
password   = YOUR_PASSWORD
; investor_id defaults to user_id when left empty
investor_id =
; app_id / auth_code are only required by brokers that enforce authentication
app_id     = simnow_client_test
auth_code  = 0000000000000000
product_info = ctp_hft

[md]
; mode = sim never connects; only mode = live reads these fronts
front      =
fronts     =
flow_path  = ./flow/md

[trader]
front      =
fronts     =
flow_path  = ./flow/trader

[query]
front      =
fronts     =
flow_path  = ./flow/query
; how often account / positions / instruments are refreshed (milliseconds)
interval_ms = 1000

[general]
; sim = synthetic market + simulated matching (no broker needed)
; live = connect to the configured CTP fronts
mode        = sim
log_dir     = ./log
; contracts the strategy trades (comma separated)
instruments = ag2612
heartbeat_ms = 500
; Enable only when collecting detailed tick-by-tick research logs.
debug_logging = false
; ---- latency tuning (see process_app.cpp applyPerformanceSettings) ------
; hybrid idle wait: tight _mm_pause spin for spin_us, then SwitchToThread
; for another spin_us, only then sleep (1 ms granularity, see timeBeginPeriod)
spin_us      = 200
; HIGH_PRIORITY_CLASS for all four processes
high_priority = true
; optional: pin a process's poll-loop thread to one core (0/absent = off):
;   [md] cpu = 2  [trader] cpu = 3  [query] cpu = 4  [strategy] cpu = 5
; CTP worker threads are never pinned, so network callbacks keep their cores.

; ---------------------------------------------------------------------------
;  simulation only
; ---------------------------------------------------------------------------
[sim]
tick_interval_ms  = 250
initial_price     = 3500
price_tick        = 1
volume_multiple   = 10
volatility        = 0.0006
mean_reversion    = 0.05
spread_ticks      = 1
; 0 = seed from the wall clock: every run gets a fresh market path
seed = 0
initial_balance   = 1000000
margin_rate       = 0.10
fee_rate          = 0.0001
order_latency_ms  = 0
partial_fills     = true

; ---------------------------------------------------------------------------
;  strategy
; ---------------------------------------------------------------------------
[strategy]
name = obi_voi

[obi_voi]
; Aggressive settings on purpose: the point of this file is to produce a fill
; within seconds, not to make money. Do NOT copy these to a live config.
entry_mode         = follow
; ---------------------------------------------------------------------------
;  L1 order book imbalance fade strategy
;  OBI  = (bidVol1 - askVol1) / (bidVol1 + askVol1)
;  VOI  = EMA(signed aggressor volume) / EMA(|aggressor volume|)
;  entry: |OBI| > obi_threshold inside window_ticks AND the VOI has crossed
;         the zero axis against the extreme -> fade on the WEAK side
;         (buy @ bid1, sell @ ask1, never deeper levels)
;  entry pull: VOI back into the extreme direction, or entry_timeout_ticks
;  exit: passive close at the touch; once VOI is against the position for
;        close_timeout_ticks without a fill -> IOC limit at the opponent price
;  inventory: net capped at max_position, at the cap closes only
; ---------------------------------------------------------------------------
window_ticks       = 8
obi_threshold      = 0.70
voi_ema_ticks      = 5
voi_flip_threshold = 0.4
entry_timeout_ticks = 4
entry_slippage_ticks = 0    ; entry crosses 1 tick toward the opponent (buy bid1+1 capped at ask1 / sell ask1-1 capped at bid1) so it fills promptly
profit_ticks       = 6
close_timeout_ticks = 3
stop_loss_ticks    = 4
max_hold_ticks     = 60
trade_volume       = 1
max_position       = 1
cooldown_ticks     = 4
allow_short        = true
flatten_on_start   = true
close_on_stop      = true
entry_taker        = 0
follow_patience_ms = 2000
max_spread_ticks   = 3
entry_stall_ticks  = 0
entry_blackout_sec = 300
daily_loss_limit_ticks = 200
max_hold_seconds   = 120
consec_stop_pause  = 99

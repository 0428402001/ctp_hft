; ============================================================================
;  ctp_hft - SimNow 7x24 configuration (standard CTP 6.7.7柜台)
;
;  SimNow 7x24 environment (看穿式前置, uses the monitoring-center production
;  key mechanism - the AppID/AuthCode below are the official SimNow test pair):
;      Trade Front  tcp://182.254.243.31:40001
;      Market Front tcp://182.254.243.31:40011
;
;  IMPORTANT - the 7x24 environment is NOT always reachable:
;      trading days     : open 16:00 -> next day 09:00
;      non-trading days : open 16:00 -> 12:00
;      outside those windows connections are refused - use
;      config_simnow.ini (set 1, 30001/30011) during the day instead.
;
;  Run the four processes from build\bin_simnow (standard-CTP flavour):
;      start_simnow724.bat
;
;  flow_path uses separate directories from config_simnow.ini so the two
;  environments can be switched without CTP stream-file mismatch errors.
;
;  Strategy parameters are kept IDENTICAL to config_simnow.ini so the two
;  environments trade the exact same logic (verified 2026-11-05).
; ============================================================================

[account]
broker_id   = 9999
user_id     = YOUR_USER_ID
password    = YOUR_PASSWORD
investor_id = YOUR_INVESTOR_ID
app_id      = simnow_client_test
auth_code   = 0000000000000000
product_info = ctp_hft

[md]
; 7x24 environment market front (16:00 -> 09:00/12:00, see note above)
front      = tcp://182.254.243.31:40011
fronts     =
flow_path  = ./flow/md724

[trader]
; 7x24 environment trade front (看穿式前置)
front      = tcp://182.254.243.31:40001
fronts     =
flow_path  = ./flow/trader724

[query]
; the query process uses a TraderApi session: point it at a TRADE front,
; not at the market-data front.
front      = tcp://182.254.243.31:40001
fronts     =
flow_path  = ./flow/query724
interval_ms = 3000

[general]
; ---- resilience -----------------------------------------------------------
; login failures never terminate a process: the process retries every
; startup_retry_ms until the front accepts logins (lunch break, night
; maintenance, front restart). clean_flow_on_start wipes stale CTP session
; files of the previous trading day so the first login of a new day works.
startup_retry       = true
startup_retry_ms    = 10000
clean_flow_on_start = true
mode        = live
log_dir     = ./log
instruments = ag2702
heartbeat_ms = 500
; latency tuning: hybrid spin wait + HIGH priority (see config.ini)
spin_us      = 500
high_priority = true

[strategy]
name = obi_voi

[obi_voi]
; ---------------------------------------------------------------------------
;  L1 order book imbalance fade strategy + BRACKET exits (user spec 2026-11-05)
;  entry: |OBI| > obi_threshold inside window_ticks AND VOI reversed with at
;         least voi_entry_threshold magnitude AND the current OBI has receded
;         from the extreme (decay confirmation) -> fade on the WEAK side
;  exit : the moment the entry fills a take-profit LIMIT rests at
;         entry +/- profit_ticks and is NEVER pulled except:
;           - price reaches stop_loss_ticks against entry -> cancel the TP
;             and fire an IOC stop crossed stop_slippage_ticks (fills NOW)
;           - (safety net only) max_hold_ticks held -> cancel + IOC
;         if the counter auto-kills the resting TP it is re-armed at most
;         once per tp_repost_interval_ticks, up to tp_repost_max times
;  inventory: net capped at max_position, at the cap closes only
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
;  Entry windows. EMPTY = no restriction: entries are allowed around the clock.
;  Set one or more windows, e.g. "21:00-02:30" or "21:00-02:30,09:00-10:15",
;  to trade only then; exits are never gated either way.
;  2026-11-12 follow mode: the measured edge lives in the DAY session
;  (day momentum +2.15t / night +0.93t t=0.43, alpha_composite.py).
trade_sessions     = 16:00-09:00
window_ticks       = 16      ; back to 16: the 16 -> 10 change was made together
                              ;   with a stall filter that was later measured and
                              ;   switched off, so the shorter window lost its reason.
                              ;   Kept identical to config_simnow.ini on purpose.
obi_threshold      = 0.90    ; 0.92 -> 0.90 together with window 16 -> 10: the
                              ;   measured set that keeps ~66-68 night entries
voi_ema_ticks      = 5
voi_flip_threshold = 0.35
voi_entry_threshold = 0.1    ; |VOI| minimum that confirms the reversal (0 = sign only)
entry_mode         = follow ; 2026-11-12: fade -> follow. Measured on 162827 ag2702
                            ;   ticks (alpha_composite.py): fading an |OBI|>=0.90 extreme
                            ;   paid -2.15t over 480 ticks in the day session, FOLLOWING
                            ;   it paid +2.15t (t=1.95).
entry_timeout_ticks = 4
entry_taker        = 0      ; follow mode is maker-first: rest at the touch, then fall
follow_patience_ms = 3000   ;   back to one taker IOC (crossing 1 tick) after 3 s unfilled.
profit_ticks       = 8      ; TP == SL == 8 (R:R 1.0)
close_timeout_ticks = 6
stop_loss_ticks    = 8
stop_slippage_ticks = 2     ; a limit IOC prints at the best level that has volume, so the
                            ;   cross width costs nothing there - it only decides whether the
                            ;   order still reaches a level with bids/offers. 1 tick missed
                            ;   the fill outright in the 11:08 run; 2 reaches the next level.
max_hold_ticks     = 0      ; off - the TP/SL bracket is the exit (safety net only if set)
max_hold_seconds   = 300    ; HARD wall-clock stop: 5 min holding -> IOC escape at any
                            ;   price (follow edge measured at h<=480 ticks, ~4 min).
                            ; (2026-11-05 18:40 an ag short sat open 14 h because its
                            ;  escape IOC was cancelled and nothing retried it)
escape_retry_ms    = 800    ; min gap between escape IOC attempts; the cross widens
                            ; one tick every 3 tries, offset walks 3 -> 4 -> 1
tp_repost_interval_ticks = 20  ; anti-storm: a resting TP lives 80-300 ms here
tp_repost_max      = 0      ; 0 = never rest a TP. SimNow cancels every
                              ;   resting order in 80-300 ms (measured: 8/8 TP
                              ;   posts per round trip returned status=5), so the
                              ;   bracket never actually rested - the exit was
                              ;   always the price-trigger IOC anyway, plus up to
                              ;   8 dead orders per round trip at the counter
max_spread_ticks   = 1      ; 2 -> 1: the target is measured from the FILL, so every
                              ;   extra tick of spread has to be travelled twice
trend_window_ms    = 30000  ; overshoot window (30 s of mid). Measured over 69
                              ;   real round trips (11-05 724 + 11-06 day, phantom
                              ;   trips removed): entering AGAINST a 0-5 tick drift
                              ;   = +40 ticks at 67 % win, against >5 ticks = +16 at
                              ;   50 %; entering WITH the drift = -153 ticks at 18 %.
                              ;   The edge is the overshoot, not the direction.
trend_min_ticks    = 1      ; how far the price must have ALREADY run against the
                              ;   entry over that window. 1 = a single tick is
                              ;   enough to prove the move happened
; The stall filter: the touch must have come `entry_stall_ticks` off the extreme
; printed in the last `stall_window_ticks` ticks. DEFAULT OFF - measured twice.
; The earlier "+4.13 -> +4.53 tick/trip" figure came from a replay WITHOUT the
; spread gate. On the universe actually traded (spread <= 1, tp16/sl8, night)
; waiting for the pullback destroys the edge: the best signals are exactly the
; ones whose impulse is still extending.
;   stall 0 -> 68 trips +4.13 | stall 2 -> 66 +3.83 | stall 4 -> 41 +3.95
;   stall 6 -> 17 +0.50      | stall 8 ->  9 -0.17 | stall 10 -> 0 trips
entry_stall_ticks  = 0
stall_window_ticks = 6
; Once the trip has printed breakeven_ticks of profit the stop moves to the
; entry price and never moves back.
breakeven_ticks    = 8
; No new entries in the last 30 minutes of a window. For a 15:00 close,
; entries stop at 14:30, avoiding the late-day losses in the 2026-11-10 report.
entry_blackout_sec = 1800
; ===== daily loss circuit breaker ==========================================
; Per-trade stops bound one trade; nothing bounded the DAY. Once realised
; losses for the trading day reach this many ticks (per lot), no new entries
; are opened - open positions still exit through their bracket. The budget
; resets when the exchange trading day rolls.
daily_loss_limit_ticks = 35
; Historical sample deviations are logged as warnings; they are not global
; startup gates. No trade_sessions configured simply means entries 24 h.
consec_stop_pause  = 3      ; after 3 losing round trips in a row, stop looking for
                            ;   entries for pause_seconds. A fade bleeds in a trend;
                            ;   2026-11-06 11:02-11:04 three shorts stopped -5/-6/-6
                            ;   inside 100 s while the mid walked 15 ticks up.
pause_seconds      = 180    ; 5 min -> 3 min: with the trend filter most of
                              ;   the losing streak cause is gone, so the
                              ;   stand-down does not need to be this long
trade_volume       = 1
max_position       = 1
cooldown_ticks     = 12     ; 20 -> 12 ticks (~6 s): the filter, not the
                              ;   cooldown, is what protects quality now
allow_short        = true
flatten_on_start   = true
close_on_stop      = true

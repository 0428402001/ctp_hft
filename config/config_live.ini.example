; ============================================================================
;  ctp_hft - LIVE configuration template
;
;  1. fill in [account] and the three front addresses below
;  2. start the four processes with  --config config\config_live.ini
;  3. watch log\*.log and monitor.exe
;
;  Front address format:  protocol://ip:port
;
;  SimNow front addresses (official notice 2025-06, host 182.254.243.31):
;    set 1 (trading hours, same as the real market - use this during the day):
;      trade 30001 / 30002 / 30003     md 30011 / 30012 / 30013
;    7x24 environment (NOT always on!):
;      trade 40001                     md 40011
;      open  trading days 16:00 -> next day 09:00, non-trading days 16:00 -> 12:00
; ============================================================================

[account]
broker_id   = 9999
user_id     = YOUR_USER_ID
password    = YOUR_PASSWORD
investor_id = YOUR_INVESTOR_ID
app_id      = simnow_client_test
auth_code   = 0000000000000000
product_info = ctp_hft

[md]
; set 1, group 1 (available during trading hours; verified reachable)
front      = tcp://182.254.243.31:30011
; 7x24 alternative (only 16:00 -> 09:00/12:00, see note above):
;front      = tcp://182.254.243.31:40011
fronts     =
flow_path  = ./flow/md

[trader]
; set 1, group 1 (available during trading hours; verified reachable)
front      = tcp://182.254.243.31:30001
; 7x24 alternative (only 16:00 -> 09:00/12:00, see note above):
;front      = tcp://182.254.243.31:40001
fronts     =
flow_path  = ./flow/trader

[query]
; the query process uses a TraderApi session: point it at a TRADE front,
; not at the market-data front.
front      = tcp://182.254.243.31:30001
fronts     =
flow_path  = ./flow/query
interval_ms = 3000

[general]
; ---- resilience -----------------------------------------------------------
; login failures never terminate a process: the process retries every
; startup_retry_ms until the front accepts logins (lunch break, night
; maintenance, front restart). clean_flow_on_start wipes stale CTP session
; files of the previous trading day so the first login of a new day works.
startup_retry       = true
startup_retry_ms    = 10000
clean_flow_on_start = true
mode        = live
log_dir     = ./log
instruments = ag2612
heartbeat_ms = 500

[strategy]
name = obi_voi

[obi_voi]
; ---------------------------------------------------------------------------
;  L1 order book imbalance fade strategy
;  OBI  = (bidVol1 - askVol1) / (bidVol1 + askVol1)
;  VOI  = EMA(signed aggressor volume) / EMA(|aggressor volume|)
;  entry: |OBI| > obi_threshold inside window_ticks AND the VOI has crossed
;         the zero axis against the extreme -> fade on the WEAK side
;         (buy @ bid1, sell @ ask1, never deeper levels)
;  entry pull: VOI back into the extreme direction, or entry_timeout_ticks
;  exit: passive close at the touch; once VOI is against the position for
;        close_timeout_ticks without a fill -> IOC limit at the opponent price
;  inventory: net capped at max_position, at the cap closes only
; ---------------------------------------------------------------------------
window_ticks       = 12
obi_threshold      = 0.7
voi_ema_ticks      = 5
voi_flip_threshold = 0.35
entry_timeout_ticks = 4
entry_slippage_ticks = 1    ; entry crosses 1 tick toward the opponent (buy bid1+1 capped at ask1 / sell ask1-1 capped at bid1) so it fills promptly
profit_ticks         = 8    ; passive close rests at entry +/- N ticks (fade captures mean reversion)
close_timeout_ticks = 3
stop_loss_ticks    = 6     ; price stop: 6 ticks against entry -> cancel TP, IOC stop
entry_blackout_sec = 1800  ; no new entries in the last 30 minutes of a configured session
daily_loss_limit_ticks = 35 ; daily realized-loss cap in ticks per lot
max_hold_ticks     = 120
trade_volume       = 1
max_position       = 1
cooldown_ticks     = 8
allow_short        = true
flatten_on_start   = true
close_on_stop      = true
